# PiPup API Testing
# -----------------
#
# To use your own IP without changing this file, create a private file in the project root:
# http-client.private.env.json
#
# NOTE: For Emulator testing, run this command in your terminal first:
# adb forward tcp:7979 tcp:7979

### Get Server State (JSON structure check)
GET {{baseUrl}}/state

### Power Control: Turn ON
POST {{baseUrl}}/power?state=on

### Power Control: Turn OFF
POST {{baseUrl}}/power?state=off

### Diagnostics: Permissions Report
GET {{baseUrl}}/permissions/diagnose

### Send a standard notification (Image)
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "duration": 30,
  "position": 0,
  "title": "API Test",
  "titleColor": "#0066cc",
  "titleSize": 20,
  "message": "Testing the HTTP Client connection...",
  "messageColor": "#000000",
  "messageSize": 14,
  "backgroundColor": "#ffffff",
  "media": {
    "image": {
      "uri": "https://mir-s3-cdn-cf.behance.net/project_modules/max_1200/cfcc3137009463.5731d08bd66a1.png",
      "width": 480
    }
  }
}

### Send a standard notification (Web)
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "duration": 15,
  "position": 2,
  "title": "Web Preview",
  "message": "Opening a website in PiP",
  "media": {
    "web": {
      "uri": "https://www.wikipedia.org",
      "width": 640,
      "height": 480
    }
  }
}

### Test Settings Transfer (STABILITY TEST - DO NOT CHANGE VALUES)
POST {{baseUrl}}/settings
Content-Type: application/json

{
  "positionIndex": 1,
  "backgroundColor": "#FF0000",
  "backgroundAlpha": 1000,
  "titleColor": "#FFFFFF",
  "titleSize": 24.0,
  "messageColor": "NOT_A_COLOR",
  "messageSize": 16.0,
  "borderRadius": 9999,
  "borderWidth": 2,
  "borderColor": "#00FF00",
  "contentPadding": 25,
  "titleAlignment": 1,
  "messageAlignment": 1,
  "mediaPosition": 1,
  "animationType": 2,
  "animationDuration": 750,
  "animationExit": true,
  "mediaTimeout": 15,
  "mediaRetries": 5,
  "appTheme": 1,
  "advancedMode": true,
  "updateChannel": 1,
  "updateInterval": 4,
  "updateNotificationStyle": 0,
  "lastUpdateCheck": 123456789,
  "updateAvailableTag": "v9.9.9",
  "updateRepeat": true,
  "lastNotifiedTag": "v8.8.8",
  "pendingUpdateId": 999,
  "pendingUpdateDigest": "abcdef",
  "pendingUpdateTagName": "v9.9.9",
  "language": "en",
  "defaultBufferMs": 500,
  "mediaLoadingPlaceholder": true,
  "mediaFullBleed": false,
  "fullscreenUpscale": false,
  "liveBadge": false,
  "liveBadgePosition": "bottom_right",
  "unknown_future_setting": "This unknown field should be ignored by the app without crashing"
}

### Send a Video/Stream notification with Poster, Buffer, Full-Bleed & LIVE Badge
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "id": "cam_front",
  "duration": 15,
  "position": "TopRight",
  "title": "Front Door",
  "message": "Motion detected",
  "cornerRadius": 24,
  "padding": 16,
  "mediaFullBleed": true,
  "liveBadge": true,
  "liveBadgeColor": "#B3261E",
  "liveBadgePosition": "bottom_right",
  "media": {
    "video": {
      "uri": "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
      "width": 480,
      "muted": true,
      "poster": "https://dummyimage.com/480x270/1a1c1e/ffffff.png&text=Camera+Snapshot",
      "posterMode": "fill",
      "bufferMs": 500
    }
  }
}

### Send a Full-Screen Canvas Notification (Web Dashboard)
POST {{baseUrl}}/notify
Content-Type: application/json

{
  "id": "dashboard_fullscreen",
  "duration": 20,
  "fullscreen": true,
  "borderWidth": 0,
  "borderRadius": 0,
  "contentPadding": 0,
  "mediaFullBleed": true,
  "overwrite": true,
  "media": {
    "web": {
      "uri": "https://www.wikipedia.org"
    }
  }
}

### Pull Current Settings
GET {{baseUrl}}/settings

### Cancel current popup
POST {{baseUrl}}/cancel


# ---------------------------------------------------------
# DEBUG & DIAGNOSTICS (Only available in Debug builds)
# ---------------------------------------------------------

### Get Memory Statistics
GET {{baseUrl}}/debug/memory

### Set Idle Timeout (e.g., 10 seconds)
POST {{baseUrl}}/debug/idle?ms=10000

### Force Immediate Unload (Eco modules cleanup)
POST {{baseUrl}}/debug/unload
