<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorSurface</item>
    </style>

    <!-- Flicker-free launch theme to keep background transparent until app logic is ready -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Main Activity theme to avoid overdraw -->
    <style name="MainTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/main_background</item>
    </style>

    <!-- Overlay settings theme -->
    <style name="SettingsTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>

        <!-- Enhance focus visibility for buttons and controls -->
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorSecondaryContainer</item>
        <item name="alertDialogTheme">@style/PiPupAlertDialogTheme</item>
    </style>

    <style name="PiPupAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorSecondaryContainer</item>
        <!-- Force high-contrast focus for dialog buttons -->
        <item name="android:buttonBarButtonStyle">@style/PiPupDialogButtonStyle</item>
    </style>

    <style name="PiPupDialogButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/focus_background</item>
    </style>
</resources>
