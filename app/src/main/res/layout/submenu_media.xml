<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_nav_media"
        android:textColor="@color/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/text_media_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_media_position"
        android:textColor="@color/colorOnSurfaceVariant"/>
    <Spinner
        android:id="@+id/spinner_media_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="8dp"/>

    <!-- Full-Bleed Media Toggle -->
    <LinearLayout
        android:id="@+id/container_media_full_bleed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_media_full_bleed"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_media_full_bleed_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_media_full_bleed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="false"/>
    </LinearLayout>

    <!-- Fullscreen Media Upscale Toggle -->
    <LinearLayout
        android:id="@+id/container_fullscreen_upscale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_fullscreen_upscale"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_fullscreen_upscale_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_fullscreen_upscale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="false"/>
    </LinearLayout>

    <!-- Live Indicator Pill Toggle -->
    <LinearLayout
        android:id="@+id/container_live_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_live_badge"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_live_badge_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="false"/>
    </LinearLayout>

    <TextView
        android:id="@+id/text_live_badge_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_live_badge_position"
        android:textColor="@color/colorOnSurfaceVariant"/>
    <Spinner
        android:id="@+id/spinner_live_badge_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="8dp"/>

    <!-- Media Loading Placeholder Toggle -->
    <LinearLayout
        android:id="@+id/container_media_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:background="@drawable/focus_background"
        android:padding="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_media_loading_placeholder"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_media_loading_placeholder_desc"
                android:textColor="@color/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_media_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="false"/>
    </LinearLayout>

</LinearLayout>
