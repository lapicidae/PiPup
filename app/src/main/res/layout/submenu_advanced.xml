<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_nav_advanced"
        android:textColor="@color/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Section 1: Expert Tools -->
    <TextView
        style="@style/SettingsSectionHeader"
        android:text="@string/settings_tools"/>

    <LinearLayout style="@style/SettingsSectionCard">
        <LinearLayout
            android:id="@+id/container_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_advanced_mode"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_advanced_mode_desc"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_advanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_clear_active_popups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_active_popups"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:textAllCaps="false"
            android:textColor="@color/colorOnSurface"/>
    </LinearLayout>

    <!-- Section 2: Media Loading -->
    <TextView
        style="@style/SettingsSectionHeader"
        android:text="@string/settings_media_loading"/>

    <LinearLayout style="@style/SettingsSectionCard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/text_media_timeout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_media_timeout"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_marginStart="12dp" />
            <TextView
                android:id="@+id/text_media_timeout_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="10s" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekbar_media_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:thumbTint="@color/tv_thumb_selector"
            android:progressTint="@color/tv_thumb_selector"
            android:progressBackgroundTint="@color/tv_track_selector"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/text_media_retries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_media_retries"
                android:textColor="@color/colorOnSurfaceVariant"
                android:layout_marginStart="12dp" />
            <TextView
                android:id="@+id/text_media_retries_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="3" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekbar_media_retries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:thumbTint="@color/tv_thumb_selector"
            android:progressTint="@color/tv_thumb_selector"
            android:progressBackgroundTint="@color/tv_track_selector" />
    </LinearLayout>

    <!-- Section 3: Migration & Sync -->
    <TextView
        style="@style/SettingsSectionHeader"
        android:text="@string/settings_migration"/>

    <LinearLayout style="@style/SettingsSectionCard">
        <Button
            android:id="@+id/btn_import_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_import_network"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:textAllCaps="false"
            android:textColor="@color/colorOnSurface"/>
    </LinearLayout>

    <!-- Section 4: Danger Zone -->
    <TextView
        style="@style/SettingsSectionHeader"
        android:text="@string/settings_danger_zone"
        android:textColor="@color/status_red"/>

    <LinearLayout style="@style/SettingsSectionCard">
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_reset_settings"
            android:textColor="@color/colorOnSurface"
            android:focusable="true"
            android:background="@drawable/focus_background"
            android:padding="12dp"
            android:gravity="start|center_vertical"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
