<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Navigation Rail -->
    <LinearLayout
        android:id="@+id/nav_rail"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@color/colorSurfaceVariant"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="25dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_banner_clear"
            app:tint="@color/colorPrimary"
            android:scaleType="fitStart"
            android:importantForAccessibility="no" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:saveEnabled="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/nav_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:saveEnabled="false"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        android:descendantFocusability="afterDescendants"
        android:contentDescription="@string/settings_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nav_rail"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/submenu_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="48dp">

            <ViewStub
                android:id="@+id/stub_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_general" />

            <ViewStub
                android:id="@+id/stub_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_background" />

            <ViewStub
                android:id="@+id/stub_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_text" />

            <ViewStub
                android:id="@+id/stub_border"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_border" />

            <ViewStub
                android:id="@+id/stub_animation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_animation" />

            <ViewStub
                android:id="@+id/stub_updates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_updates" />

            <ViewStub
                android:id="@+id/stub_modules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_modules" />

            <ViewStub
                android:id="@+id/stub_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_permissions" />

            <ViewStub
                android:id="@+id/stub_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_advanced" />

            <ViewStub
                android:id="@+id/stub_performance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_performance" />

            <ViewStub
                android:id="@+id/stub_module_dynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/submenu_module_dynamic" />

        </LinearLayout>
    </ScrollView>

    <!-- Live Preview Container (Truly an overlay) -->
    <FrameLayout
        android:id="@+id/preview_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="false"
        android:focusable="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
